# just a flag
ENV = 'development'

# 后端服务地址(端口 14010)：开发环境 vite.config.js 中 server.proxy 的转发目标。
# 更换后端地址或端口时只改这一处，无需再改动 vite.config.js。
VITE_APP_PROXY_TARGET = 'http://localhost:14010'

# base api
# knife4go 后端的 swagger-config 返回的 url 字段已经是完整绝对路径（如 /swagger/doc.json），
# 前端 axios 应把它当绝对路径直接用，不再拼前缀。因此这里保持为空字符串，
# 与 .env.production 一致。/swagger 前缀的请求由 vite.config.js 的 proxy 转发到后端 14010。
VITE_APP_BASE_API = ''
# 发行版本类型 可选值: SpringDocOpenApi | Knife4jSpringUi | Knife4jJFinal | Knife4jFront
#VITE_RELEASE_APP_TYPE = 'SpringDocOpenApi'